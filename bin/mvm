#!/usr/bin/env python3
"""mvm - run dev tooling in throwaway Podman+krun microVMs.

  mvm fetch [ECO] [-- CMD]          download/change dependencies (the only networked step)
  mvm build [go|rust|node] -- CMD   build offline against the fetched caches
  mvm run -i IMAGE -- CMD           run any image offline
  mvm status                        caches, pinned images, recent runs
  mvm update                        re-pull and re-pin images
  mvm cache rm|grow|gc              manage cache images

State:
  ~/.cache/mvm/<name>.img        ext4 cache images (+ .lock, .meta.json)
  ~/.local/state/mvm/pins.json   image tag -> pinned digest
  ~/.local/state/mvm/runs/       one JSON record per run
  ~/.config/mvm/config.toml      optional host config

Every writable cache is written through a reflink copy and committed only when
the command exits 0; anything else (failure, Ctrl-C, crash) leaves it untouched.
Standard library only.
"""

from __future__ import annotations

import fcntl
import fnmatch
import hashlib
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import tomllib
from dataclasses import dataclass, field
from pathlib import Path

HOME = Path.home()
CACHE_ROOT = Path(os.environ.get("MVM_CACHE_DIR", HOME / ".cache" / "mvm"))
STATE_ROOT = Path(os.environ.get("MVM_STATE_DIR", HOME / ".local" / "state" / "mvm"))
CONFIG_PATH = Path(os.environ.get("MVM_CONFIG", HOME / ".config" / "mvm" / "config.toml"))
KEEP_RUNS = 200

DEFAULT_MASK = [
    ".git", ".env", ".env.*", ".envrc", ".npmrc", ".netrc", ".pypirc",
    "*.pem", "*.key", "id_rsa*", "id_ecdsa*", "id_ed25519*",
]
# Directories never descended into when looking for masks or manifests.
SKIP_DIRS = {".git", "node_modules", "target", "vendor", ".venv", "__pycache__"}


@dataclass
class Cache:
    name: str
    guest: str
    rw: bool
    size: str = "4G"


@dataclass
class Eco:
    name: str
    image: str
    memory: str
    detect: str
    manifests: list[str]
    fetch_cmd: list[str]
    env: dict[str, str]
    build_env: dict[str, str] = field(default_factory=dict)
    fetch_env: dict[str, str] = field(default_factory=dict)


ECOS: dict[str, Eco] = {
    "go": Eco(
        name="go",
        image="docker.io/library/golang:1.27-alpine",
        memory="2g",
        detect="go.mod",
        manifests=["go.mod", "go.sum", "go.work", "go.work.sum"],
        fetch_cmd=["go", "mod", "download"],
        # GOTOOLCHAIN=local: never download a newer Go toolchain (that is code that runs).
        # -buildvcs=false: .git is masked, so do not try to stamp VCS info.
        env={"CGO_ENABLED": "0", "GOMODCACHE": "/cache/go-mod", "GOCACHE": "/cache/go-build",
             "GOTOOLCHAIN": "local", "GOFLAGS": "-buildvcs=false"},
        build_env={"GOPROXY": "off"},
    ),
    "rust": Eco(
        name="rust",
        image="docker.io/library/rust:1.98-alpine",
        memory="4g",
        detect="Cargo.toml",
        manifests=["Cargo.toml", "Cargo.lock"],
        fetch_cmd=["cargo", "fetch"],
        env={"CARGO_TARGET_DIR": "/cache/target"},
        build_env={"CARGO_NET_OFFLINE": "true"},
    ),
    "node": Eco(
        name="node",
        image="docker.io/library/node:22-alpine",
        memory="2g",
        detect="package.json",
        manifests=["package.json", "package-lock.json", "npm-shrinkwrap.json"],
        # Install scripts never run with network; run them offline: mvm build node -- npm rebuild
        fetch_cmd=["npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"],
        env={"npm_config_cache": "/cache/npm", "npm_config_update_notifier": "false"},
        # Enforced for every fetch, including `mvm fetch node -- npm install x`.
        fetch_env={"npm_config_ignore_scripts": "true"},
        build_env={"npm_config_offline": "true"},
    ),
}


class MvmError(Exception):
    pass


def die(msg: str, code: int = 2) -> None:
    print(f"mvm: {msg}", file=sys.stderr)
    sys.exit(code)


def say(msg: str) -> None:
    print(f"mvm: {msg}", file=sys.stderr)


def now_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


# ---------------------------------------------------------------- config / pins


def load_config() -> dict:
    if not CONFIG_PATH.exists():
        return {}
    with open(CONFIG_PATH, "rb") as f:
        return tomllib.load(f)


def write_json_atomic(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    os.replace(tmp, path)


def read_json(path: Path, default):
    try:
        return json.loads(path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return default


def pins_path() -> Path:
    return STATE_ROOT / "pins.json"


def image_repo(tag: str) -> str:
    """Strip a :tag (not a registry :port) from an image reference."""
    ref = tag.split("@", 1)[0]
    slash = ref.rfind("/")
    colon = ref.rfind(":")
    return ref[:colon] if colon > slash else ref


def podman_out(args: list[str]) -> str:
    return subprocess.run(["podman", *args], check=True, capture_output=True, text=True).stdout.strip()


def resolve_digest(tag: str, pull: bool) -> str:
    if pull or subprocess.run(["podman", "image", "exists", tag]).returncode != 0:
        say(f"pulling {tag}")
        subprocess.run(["podman", "pull", "-q", tag], check=True, stdout=subprocess.DEVNULL)
    digest = podman_out(["image", "inspect", "--format", "{{.Digest}}", tag])
    if not digest.startswith("sha256:"):
        raise MvmError(f"could not resolve digest for {tag}: {digest!r}")
    return f"{image_repo(tag)}@{digest}"


def pinned(tag: str) -> str:
    """Return tag pinned to a digest; pin on first use (trust on first use)."""
    if "@sha256:" in tag:
        return tag
    pins = read_json(pins_path(), {})
    if tag in pins:
        return pins[tag]["ref"]
    ref = resolve_digest(tag, pull=False)
    pins[tag] = {"ref": ref, "pinned_at": now_iso()}
    write_json_atomic(pins_path(), pins)
    say(f"pinned {tag} -> {ref}")
    return ref


# ---------------------------------------------------------------- caches


def cache_img(name: str) -> Path:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", name):
        die(f"invalid cache name: {name!r}")
    return CACHE_ROOT / f"{name}.img"


def cache_lock(name: str) -> Path:
    return CACHE_ROOT / f"{name}.lock"


def cache_meta(name: str) -> Path:
    return CACHE_ROOT / f"{name}.meta.json"


def find_sbin(tool: str) -> str:
    for p in (f"/usr/sbin/{tool}", f"/sbin/{tool}", shutil.which(tool) or ""):
        if p and os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    die(f"required tool not found: {tool}")
    return ""


def ensure_cache(c: Cache, project: Path | None = None) -> Path:
    CACHE_ROOT.mkdir(parents=True, exist_ok=True)
    img = cache_img(c.name)
    if not img.exists():
        say(f"creating cache {c.name} ({c.size}, sparse ext4)")
        tmp = img.with_name(img.name + ".new")
        subprocess.run(["truncate", "-s", c.size, str(tmp)], check=True)
        # ^orphan_file: avoids a harmless but noisy warning on read-only mounts in the guest.
        subprocess.run([find_sbin("mkfs.ext4"), "-q", "-F", "-O", "^orphan_file", str(tmp)], check=True)
        os.replace(tmp, img)
        meta = {"generation": 0, "created_at": now_iso()}
        if project:
            meta["project"] = str(project)
        write_json_atomic(cache_meta(c.name), meta)
    return img


def run_copies(name: str) -> list[Path]:
    return sorted(CACHE_ROOT.glob(f"{name}.img.run-*"))


class Locks:
    """flock per cache: shared for read-only, exclusive for writable. Sorted to avoid deadlocks."""

    def __init__(self, caches: list[Cache]):
        want: dict[str, bool] = {}
        for c in caches:
            want[c.name] = want.get(c.name, False) or c.rw
        self.want = want
        self.fds: list = []

    def __enter__(self):
        CACHE_ROOT.mkdir(parents=True, exist_ok=True)
        for name in sorted(self.want):
            mode = fcntl.LOCK_EX if self.want[name] else fcntl.LOCK_SH
            fd = open(cache_lock(name), "a")
            try:
                fcntl.flock(fd, mode | fcntl.LOCK_NB)
            except BlockingIOError:
                say(f"waiting for {'exclusive' if self.want[name] else 'shared'} lock on cache {name}")
                fcntl.flock(fd, mode)
            self.fds.append(fd)
        return self

    def __exit__(self, *exc):
        for fd in reversed(self.fds):
            try:
                fcntl.flock(fd, fcntl.LOCK_UN)
            finally:
                fd.close()
        return False


def make_run_copy(name: str, run_id: str) -> Path:
    """Caller holds the exclusive lock. Drop stale copies, then reflink-copy the image."""
    for stale in run_copies(name):
        stale.unlink(missing_ok=True)
    src = cache_img(name)
    dst = src.with_name(f"{src.name}.run-{run_id}")
    subprocess.run(["cp", "--reflink=auto", "--sparse=always", str(src), str(dst)], check=True)
    return dst


def commit_copy(name: str, copy: Path, run_id: str) -> int:
    """Atomically replace the cache with the run's copy; return the new generation."""
    os.replace(copy, cache_img(name))
    meta = read_json(cache_meta(name), {})
    meta["generation"] = int(meta.get("generation", 0)) + 1
    meta["committed_at"] = now_iso()
    meta["committed_by"] = run_id
    write_json_atomic(cache_meta(name), meta)
    return meta["generation"]


# ---------------------------------------------------------------- project inspection


def walk_project(root: Path):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS)
        yield Path(dirpath), dirnames, filenames


def detect_ecos(root: Path) -> list[str]:
    return [e.name for e in ECOS.values() if (root / e.detect).is_file()]


def find_masks(root: Path, patterns: list[str]) -> tuple[list[str], list[str]]:
    """Return (dirs, files) relative to root whose basename matches a mask pattern."""
    dirs, files = [], []
    for dirpath, dirnames, filenames in os.walk(root):
        rel = Path(dirpath).relative_to(root)
        keep = []
        for d in sorted(dirnames):
            if any(fnmatch.fnmatch(d, p) for p in patterns):
                dirs.append(str(rel / d))
            elif d not in SKIP_DIRS:
                keep.append(d)
        dirnames[:] = keep
        for f in sorted(filenames):
            if any(fnmatch.fnmatch(f, p) for p in patterns):
                files.append(str(rel / f))
    return dirs, files


def cargo_target_paths(manifest: Path) -> list[str]:
    """Target source files cargo needs to exist to parse a manifest (cargo-chef's trick)."""
    try:
        data = tomllib.loads(manifest.read_text())
    except (tomllib.TOMLDecodeError, OSError):
        return []
    paths = ["src/main.rs", "src/lib.rs"]
    lib = data.get("lib")
    if isinstance(lib, dict) and "path" in lib:
        paths.append(lib["path"])
    for kind in ("bin", "example", "test", "bench"):
        for t in data.get(kind, []) or []:
            if isinstance(t, dict) and "path" in t:
                paths.append(t["path"])
    pkg = data.get("package")
    if isinstance(pkg, dict) and isinstance(pkg.get("build"), str):
        paths.append(pkg["build"])
    return paths


def manifest_tree(root: Path, eco: Eco, dest: Path) -> int:
    """Copy only dependency manifests of `eco` from root into dest; stub cargo targets empty."""
    n = 0
    for dirpath, _dirs, filenames in walk_project(root):
        rel = dirpath.relative_to(root)
        for f in filenames:
            if f in eco.manifests:
                (dest / rel).mkdir(parents=True, exist_ok=True)
                shutil.copy2(dirpath / f, dest / rel / f)
                n += 1
                if eco.name == "rust" and f == "Cargo.toml":
                    for p in cargo_target_paths(dirpath / f):
                        if (dirpath / p).is_file():
                            stub = dest / rel / p
                            stub.parent.mkdir(parents=True, exist_ok=True)
                            stub.touch()
    return n


def project_cache_name(prefix: str, project: Path) -> str:
    h = hashlib.sha256(str(project).encode()).hexdigest()[:8]
    base = re.sub(r"[^A-Za-z0-9._-]", "_", project.name)[:24] or "root"
    return f"{prefix}-{base}-{h}"


def eco_caches(eco: Eco, phase: str, project: Path) -> list[Cache]:
    fetch = phase == "fetch"
    if eco.name == "go":
        cs = [Cache("go-mod", "/cache/go-mod", fetch, "4G")]
        if not fetch:
            cs.append(Cache("go-build", "/cache/go-build", True, "8G"))
    elif eco.name == "rust":
        cs = [Cache("cargo-reg", "/usr/local/cargo/registry", fetch, "4G"),
              Cache("cargo-git", "/usr/local/cargo/git", fetch, "2G")]
        if not fetch:
            cs.append(Cache("cargo-target", "/cache/target", True, "8G"))
    else:
        # node_modules is per project; build keeps it writable for `npm rebuild`.
        cs = [Cache("npm", "/cache/npm", fetch, "4G"),
              Cache(project_cache_name("nm", project), "/src/node_modules", True, "4G")]
    return cs


# ---------------------------------------------------------------- running


@dataclass
class Plan:
    kind: str                 # fetch | build | run
    eco: str | None
    image: str                # pinned ref
    memory: str
    cmd: list[str]
    src: Path | None          # host dir mounted read-only at /src
    net: bool = False
    caches: list[Cache] = field(default_factory=list)
    env: dict[str, str] = field(default_factory=dict)
    writable: list[str] = field(default_factory=list)   # project-relative dirs
    masks: tuple[list[str], list[str]] = ([], [])
    interactive: bool = False
    project: Path | None = None
    src_rw: bool = False      # only the throwaway fetch tree is writable


def new_run_id() -> str:
    return time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + secrets.token_hex(3)


def podman_argv(plan: Plan, run_id: str, mounts: dict[str, Path], empty_dir: Path) -> list[str]:
    """Build the podman command. `mounts` maps cache name -> image file to attach."""
    argv = ["podman", "run", "--rm", "--runtime", "krun", "--memory", plan.memory,
            "--name", f"mvm-{run_id}", "--label", f"mvm.run={run_id}",
            "--label", f"mvm.pid={os.getpid()}"]
    if not plan.net:
        argv.append("--network=none")
    if plan.interactive:
        argv.append("-it")
    if plan.src is not None:
        argv += ["-v", f"{plan.src}:/src:{'z' if plan.src_rw else 'ro,z'}", "-w", "/src"]
        # Writable dirs first, masks after: later mounts win, so a mask inside a -w dir still hides.
        for w in plan.writable:
            argv += ["-v", f"{plan.src / w}:/src/{w}:z"]
        mdirs, mfiles = plan.masks
        # podman --tmpfs is ignored under krun; an empty read-only dir hides a directory.
        for d in mdirs:
            argv += ["-v", f"{empty_dir}:/src/{d}:ro,z"]
        for f in mfiles:
            argv += ["-v", f"/dev/null:/src/{f}:ro"]
    for k, v in sorted(plan.env.items()):
        argv += ["-e", f"{k}={v}"]
    lines = ["set -eu"]
    umounts = []
    for idx, c in enumerate(plan.caches):
        guest_img = f"/run/mvm-imgs/{idx}-{c.name}.img"
        argv += ["-v", f"{mounts[c.name]}:{guest_img}:{'z' if c.rw else 'ro,z'}"]
        lines.append(f"mkdir -p {shlex.quote(c.guest)} && "
                     f"mount -o {'loop' if c.rw else 'loop,ro'} {shlex.quote(guest_img)} {shlex.quote(c.guest)}")
        umounts.append(c.guest)
    argv.append(plan.image)
    if not umounts:
        return argv + plan.cmd
    # Unmount explicitly so the ext4 image is clean before it is committed.
    lines.append(f"cleanup() {{ sync; umount {' '.join(shlex.quote(p) for p in reversed(umounts))} 2>/dev/null || true; }}")
    lines.append("trap cleanup EXIT")
    lines.append(" ".join(shlex.quote(a) for a in plan.cmd))
    return argv + ["sh", "-c", "\n".join(lines)]


def run_podman(argv: list[str]) -> int:
    return subprocess.run(argv).returncode


def kill_container(run_id: str) -> None:
    subprocess.run(["podman", "kill", f"mvm-{run_id}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def reap_orphans() -> list[str]:
    """Kill mvm containers whose mvm process is gone (e.g. mvm was SIGKILLed)."""
    try:
        out = podman_out(["ps", "--filter", "label=mvm.run",
                          "--format", '{{.Names}} {{index .Labels "mvm.pid"}}'])
    except (subprocess.CalledProcessError, FileNotFoundError):
        return []
    reaped = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) != 2 or not parts[1].isdigit():
            continue
        name, pid = parts
        if not Path(f"/proc/{pid}").exists():
            subprocess.run(["podman", "kill", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            reaped.append(name)
    return reaped


def record_path(run_id: str) -> Path:
    return STATE_ROOT / "runs" / f"{run_id}.json"


def prune_records() -> None:
    recs = sorted((STATE_ROOT / "runs").glob("*.json"))
    for old in recs[:-KEEP_RUNS]:
        old.unlink(missing_ok=True)


def execute(plan: Plan) -> int:
    run_id = new_run_id()
    reap_orphans()
    project = plan.project
    for c in plan.caches:
        ensure_cache(c, project if c.name.startswith("nm-") else None)
    rec = {"id": run_id, "kind": plan.kind, "eco": plan.eco, "image": plan.image,
           "cmd": plan.cmd, "cwd": str(project or Path.cwd()),
           "egress": "open" if plan.net else "none", "started_at": now_iso(),
           "caches": {c.name: ("rw" if c.rw else "ro") for c in plan.caches}}
    write_json_atomic(record_path(run_id), rec)

    copies: dict[str, Path] = {}
    rc = 130
    result = "interrupted"
    try:
        with Locks(plan.caches), tempfile.TemporaryDirectory(prefix="mvm-empty-") as empty:
            mounts = {}
            for c in plan.caches:
                if c.rw and c.name not in copies:
                    copies[c.name] = make_run_copy(c.name, run_id)
                mounts[c.name] = copies.get(c.name, cache_img(c.name))
            argv = podman_argv(plan, run_id, mounts, Path(empty))
            try:
                rc = run_podman(argv)
            except KeyboardInterrupt:
                kill_container(run_id)
                raise
            if rc == 0:
                rec["generations"] = {n: commit_copy(n, cp, run_id) for n, cp in copies.items()}
                copies.clear()
                result = "committed" if rec["generations"] else "ok"
            else:
                result = "failed"
    finally:
        for copy in copies.values():          # anything not committed is discarded
            copy.unlink(missing_ok=True)
        rec.update(exit=rc, result=result, finished_at=now_iso())
        write_json_atomic(record_path(run_id), rec)
        prune_records()
        label = f"{plan.kind} {plan.eco}" if plan.eco else plan.kind
        if result == "committed":
            gens = ", ".join(f"{k} gen {v}" for k, v in rec["generations"].items())
            say(f"{label}: committed {gens} (run {run_id})")
        elif copies:
            say(f"{label}: {result}, exit {rc}, cache writes discarded (run {run_id})")
    return rc


# ---------------------------------------------------------------- commands


def parse_opts(args: list[str], allow_image: bool) -> tuple[dict, list[str]]:
    opts: dict = {"writable": [], "interactive": False, "image": None, "positional": []}
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            if not args[i + 1:]:
                break
            return opts, args[i + 1:]
        if a == "-w" and i + 1 < len(args):
            opts["writable"].append(args[i + 1])
            i += 2
        elif a == "--it":
            opts["interactive"] = True
            i += 1
        elif allow_image and a == "-i" and i + 1 < len(args):
            opts["image"] = args[i + 1]
            i += 2
        elif a.startswith("-"):
            die(f"unknown option {a!r} (see mvm --help)")
        else:
            opts["positional"].append(a)
            i += 1
    die("missing `-- COMMAND`")
    return opts, []


def check_writable(root: Path, dirs: list[str]) -> list[str]:
    out = []
    for d in dirs:
        p = (root / d).resolve()
        if p == root or root not in p.parents:
            die(f"-w {d!r} must be a subdirectory of {root}")
        p.mkdir(parents=True, exist_ok=True)
        out.append(str(p.relative_to(root)))
    return out


def memory_for(cfg: dict, key: str, default: str) -> str:
    return str(cfg.get("memory", {}).get(key, default))


def image_for(cfg: dict, eco: Eco) -> str:
    return pinned(cfg.get("images", {}).get(eco.name, eco.image))


def changed_manifests(root: Path, tree: Path, eco: Eco) -> list[str]:
    """Manifest/lockfile paths in tree that are new or differ from the project."""
    out = []
    for p in sorted(tree.rglob("*")):
        if p.is_file() and p.name in eco.manifests:
            rel = p.relative_to(tree)
            dst = root / rel
            if not dst.is_file() or dst.read_bytes() != p.read_bytes():
                out.append(str(rel))
    return out


def cmd_fetch(args: list[str]) -> int:
    root = Path.cwd().resolve()
    custom: list[str] = []
    if "--" in args:
        i = args.index("--")
        args, custom = args[:i], args[i + 1:]
        if not custom:
            die("missing command after --")
    if len(args) > 1 or (args and args[0] not in ECOS):
        die(f"usage: mvm fetch [{'|'.join(ECOS)}] [-- CMD]")
    ecos = args or detect_ecos(root)
    if custom and len(ecos) != 1:
        die(f"found {', '.join(ecos) or 'no'} ecosystem(s) here; name one: mvm fetch {'|'.join(ECOS)} -- CMD")
    if not ecos:
        die("nothing to fetch: no go.mod, Cargo.toml or package.json here")
    cfg = load_config()
    say("egress: open (allowlist proxy arrives in stage 2), observer: off")
    for name in ecos:
        eco = ECOS[name]
        with tempfile.TemporaryDirectory(prefix=f"mvm-fetch-{name}-") as tmp:
            tree = Path(tmp)
            manifest_tree(root, eco, tree)
            cmd = custom or list(eco.fetch_cmd)
            if not custom and name == "rust" and (root / "Cargo.lock").is_file():
                cmd.append("--locked")
            if name == "node":
                (tree / "node_modules").mkdir(exist_ok=True)
            plan = Plan(kind="fetch", eco=name, image=image_for(cfg, eco),
                        memory=memory_for(cfg, name, eco.memory), cmd=cmd, src=tree, src_rw=True,
                        net=True, caches=eco_caches(eco, "fetch", root), env={**eco.env, **eco.fetch_env},
                        project=root)
            rc = execute(plan)
            if rc != 0:
                return rc
            # Only dependency manifests ever flow back into the project.
            for rel in changed_manifests(root, tree, eco):
                (root / rel).parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(tree / rel, root / rel)
                say(f"updated {rel}")
    if "node" in ecos:
        say("node: install scripts were skipped; run them offline: mvm build node -- npm rebuild")
    return 0


def cmd_build(args: list[str]) -> int:
    opts, cmd = parse_opts(args, allow_image=False)
    root = Path.cwd().resolve()
    pos = opts["positional"]
    if len(pos) > 1 or (pos and pos[0] not in ECOS):
        die(f"usage: mvm build [{'|'.join(ECOS)}] [-w DIR] [--it] -- CMD")
    if pos:
        name = pos[0]
    else:
        found = detect_ecos(root)
        if len(found) != 1:
            die(f"found {', '.join(found) or 'no'} ecosystem(s) here; name one: mvm build {'|'.join(ECOS)} -- CMD")
        name = found[0]
    eco = ECOS[name]
    cfg = load_config()
    if name == "node":
        (root / "node_modules").mkdir(exist_ok=True)   # mount point for the per-project cache
    plan = Plan(kind="build", eco=name, image=image_for(cfg, eco),
                memory=memory_for(cfg, name, eco.memory), cmd=cmd, src=root,
                caches=eco_caches(eco, "build", root), env={**eco.env, **eco.build_env},
                writable=check_writable(root, opts["writable"]),
                masks=find_masks(root, cfg.get("mask", DEFAULT_MASK)),
                interactive=opts["interactive"], project=root)
    return execute(plan)


def cmd_run(args: list[str]) -> int:
    opts, cmd = parse_opts(args, allow_image=True)
    if not opts["image"] or opts["positional"]:
        die("usage: mvm run -i IMAGE [-w DIR] [--it] -- CMD")
    root = Path.cwd().resolve()
    cfg = load_config()
    plan = Plan(kind="run", eco=None, image=pinned(opts["image"]),
                memory=memory_for(cfg, "run", "2g"), cmd=cmd, src=root,
                writable=check_writable(root, opts["writable"]),
                masks=find_masks(root, cfg.get("mask", DEFAULT_MASK)),
                interactive=opts["interactive"], project=root)
    return execute(plan)


def cmd_update(args: list[str]) -> int:
    if args:
        die("update takes no arguments")
    pins = read_json(pins_path(), {})
    if not pins:
        say("nothing pinned yet")
        return 0
    for tag in sorted(pins):
        old = pins[tag]["ref"]
        new = resolve_digest(tag, pull=True)
        if new != old:
            pins[tag] = {"ref": new, "pinned_at": now_iso(), "previous": old}
            print(f"{tag}: {old.split('@')[1][:19]} -> {new.split('@')[1][:19]}")
        else:
            print(f"{tag}: unchanged")
    write_json_atomic(pins_path(), pins)
    return 0


def human(n: float) -> str:
    for unit in ("B", "K", "M", "G"):
        if n < 1024 or unit == "G":
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return str(n)


def cmd_status(args: list[str]) -> int:
    if args:
        die("status takes no arguments")
    cfg_state = str(CONFIG_PATH) if CONFIG_PATH.exists() else f"{CONFIG_PATH} (absent, defaults)"
    print(f"config   {cfg_state}")
    print("egress   open during fetch (stage 2 adds the allowlist proxy)")
    print("observer off")
    print("\nimages")
    pins = read_json(pins_path(), {})
    for tag in sorted(pins):
        print(f"  {tag:<42} {pins[tag]['ref'].split('@')[1][:19]}  pinned {pins[tag]['pinned_at']}")
    if not pins:
        print("  (none pinned yet)")
    print("\ncaches")
    imgs = sorted(CACHE_ROOT.glob("*.img"))
    for img in imgs:
        st = img.stat()
        meta = read_json(cache_meta(img.stem), {})
        extra = f"  {meta['project']}" if "project" in meta else ""
        print(f"  {img.stem:<28} {human(st.st_blocks * 512):>7} / {human(st.st_size):>6}  "
              f"gen {str(meta.get('generation', '?')):<4} {meta.get('committed_at', '-')}{extra}")
    if not imgs:
        print("  (none)")
    leftovers = sorted(CACHE_ROOT.glob("*.img.run-*"))
    if leftovers:
        print(f"  {len(leftovers)} leftover run copies (mvm cache gc removes them)")
    print("\nrecent runs")
    recs = sorted((STATE_ROOT / "runs").glob("*.json"))[-10:]
    for p in recs:
        r = read_json(p, {})
        cmd = " ".join(r.get("cmd", []))
        print(f"  {r.get('id', p.stem):<24} {r.get('kind', '?'):<5} {str(r.get('eco') or '-'):<4} "
              f"{str(r.get('result', 'running?')):<11} exit {str(r.get('exit', '-')):<4} {cmd[:60]}")
    if not recs:
        print("  (none)")
    return 0


def try_exclusive(name: str):
    fd = open(cache_lock(name), "a")
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return fd
    except BlockingIOError:
        fd.close()
        return None


def cmd_cache(args: list[str]) -> int:
    usage = "usage: mvm cache rm NAME | grow NAME SIZE | gc"
    if not args:
        die(usage)
    sub, rest = args[0], args[1:]
    CACHE_ROOT.mkdir(parents=True, exist_ok=True)
    if sub == "rm" and len(rest) == 1:
        img = cache_img(rest[0])
        if not img.exists():
            die(f"no such cache: {rest[0]}")
        fd = try_exclusive(rest[0])
        if fd is None:
            die(f"cache {rest[0]} is in use")
        try:
            for p in [img, cache_meta(rest[0]), *run_copies(rest[0])]:
                p.unlink(missing_ok=True)
        finally:
            fd.close()
        say(f"removed {rest[0]}")
        return 0
    if sub == "grow" and len(rest) == 2:
        name, size = rest
        img = cache_img(name)
        if not img.exists():
            die(f"no such cache: {name}")
        fd = try_exclusive(name)
        if fd is None:
            die(f"cache {name} is in use")
        try:
            subprocess.run(["truncate", "-s", size, str(img)], check=True)
            r = subprocess.run([find_sbin("e2fsck"), "-f", "-p", str(img)])
            if r.returncode not in (0, 1):
                die(f"e2fsck exited with {r.returncode}")
            subprocess.run([find_sbin("resize2fs"), str(img)], check=True)
        finally:
            fd.close()
        return 0
    if sub == "gc" and not rest:
        for name in reap_orphans():
            say(f"killed orphaned container {name}")
        for copy in sorted(CACHE_ROOT.glob("*.img.run-*")):
            name = copy.name.split(".img.run-")[0]
            fd = try_exclusive(name)
            if fd is None:
                continue
            try:
                copy.unlink(missing_ok=True)
                say(f"removed leftover {copy.name}")
            finally:
                fd.close()
        for img in sorted(CACHE_ROOT.glob("nm-*.img")):
            proj = read_json(cache_meta(img.stem), {}).get("project")
            if proj and not Path(proj).is_dir():
                fd = try_exclusive(img.stem)
                if fd is None:
                    continue
                try:
                    img.unlink(missing_ok=True)
                    cache_meta(img.stem).unlink(missing_ok=True)
                    say(f"removed {img.stem} (project {proj} is gone)")
                finally:
                    fd.close()
        return 0
    die(usage)
    return 2


USAGE = """\
mvm - run dev tooling in throwaway Podman+krun microVMs

  mvm fetch [go|rust|node] [-- CMD]    download dependencies; with CMD, change them
                                       (go get, cargo add, npm install ...)
  mvm build [go|rust|node] [-w DIR] [--it] -- CMD
                                       build offline against the fetched caches
  mvm run -i IMAGE [-w DIR] [--it] -- CMD
                                       run any image offline
  mvm status                           config, pinned images, caches, recent runs
  mvm update                           re-pull and re-pin images
  mvm cache rm NAME | grow NAME SIZE | gc

  -w DIR   make ./DIR writable (the project is read-only otherwise)
  --it     interactive terminal

fetch is the only command with network. It sees only the dependency manifests
(go.mod, Cargo.toml, package.json and their lockfiles), never your sources, and
only changed manifests are copied back. npm install scripts are skipped by
default (run them offline: mvm build node -- npm rebuild).
build and run hide .git, .env* and key files (config: mask = [...]).
Cache writes are committed only when the command exits 0.

Examples:
  mvm fetch
  mvm fetch go -- go get golang.org/x/net@latest
  mvm fetch node -- npm install --ignore-scripts left-pad
  mvm build -w build -- go build -o build/app ./cmd/app
  mvm build rust -- cargo test
  mvm run -i docker.io/library/alpine:3.24 -- uname -a
"""


def _sigterm(*_):
    raise KeyboardInterrupt


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0
    signal.signal(signal.SIGTERM, _sigterm)
    cmds = {"fetch": cmd_fetch, "build": cmd_build, "run": cmd_run, "status": cmd_status,
            "update": cmd_update, "cache": cmd_cache}
    fn = cmds.get(argv[0])
    if fn is None:
        die(f"unknown command {argv[0]!r} (see mvm --help)")
    try:
        return fn(argv[1:])
    except KeyboardInterrupt:
        say("interrupted")
        return 130
    except (MvmError, subprocess.CalledProcessError) as e:
        die(str(e), 1)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

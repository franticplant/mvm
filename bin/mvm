#!/usr/bin/env python3
"""mvm launcher: finds the mvm package (installed or in the source tree) and runs it."""
import sys
from pathlib import Path

here = Path(__file__).resolve().parent
for root in (here.parent / "lib" / "mvm", here.parent):
    if (root / "mvm" / "cli.py").is_file():
        sys.path.insert(0, str(root))
        break
else:
    sys.exit("mvm: package not found next to the launcher (run `make install`)")

from mvm.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))

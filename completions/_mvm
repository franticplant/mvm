#compdef mvm

_mvm_cache_names() {
  local dir="${MVM_CACHE_DIR:-$HOME/.cache/mvm}"
  local -a names
  local f
  for f in "$dir"/*.img(N); do names+=("${f:t:r}"); done
  _describe -t caches 'cache' names
}

_mvm() {
  local -a cmds
  cmds=(
    'fetch:download or change dependencies (only networked step)'
    'build:build offline against the fetched caches'
    'run:run any image offline'
    'status:config, pinned images, caches, recent runs'
    'update:re-pull and re-pin images'
    'cache:manage cache images'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'mvm command' cmds
    return
  fi
  if (( ${words[(I)--]} && ${words[(I)--]} < CURRENT )); then
    _files
    return
  fi
  case "$words[2]" in
    fetch) _arguments '--learn[allow but log every host, commit nothing]' '1::ecosystem:(go rust node)' ;;
    build) _arguments '*-w[make DIR writable]:dir:_directories' '--it[interactive terminal]' '1::ecosystem:(go rust node)' ;;
    run)   _arguments '-i[image]:image:' '*-w[make DIR writable]:dir:_directories' '--it[interactive terminal]' ;;
    cache)
      if (( CURRENT == 3 )); then
        _values 'cache command' rm grow gc
      elif (( CURRENT == 4 )) && [[ "$words[3]" == (rm|grow) ]]; then
        _mvm_cache_names
      fi ;;
  esac
}

_mvm "$@"

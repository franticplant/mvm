#compdef mvm

_mvm_cache_names() {
  local dir="${MVM_CACHE_DIR:-$HOME/.cache/mvm}"
  local -a names
  local f
  for f in "$dir"/*.img(N); do
    names+=("${f:t:r}")
  done
  _describe -t caches 'mvm cache image' names
}

_mvm_cache() {
  local -a subcmds
  subcmds=(
    'ls:List ext4 cache images'
    'init:Create an empty sparse ext4 cache image'
    'import:Populate a sparse ext4 cache image from a host directory'
    'grow:Expand an existing sparse ext4 cache image'
    'rm:Remove a cache image and lockfile'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'cache subcommand' subcmds
    return
  fi

  case "$words[2]" in
    grow|rm)
      if (( CURRENT == 3 )); then
        _mvm_cache_names
      elif [[ "$words[2]" == "grow" && CURRENT == 4 ]]; then
        _values 'size' 2G 4G 6G 8G 12G 16G
      fi
      ;;
    init)
      if (( CURRENT == 3 )); then
        _message 'new cache name'
      elif (( CURRENT == 4 )); then
        _values 'size' 2G 4G 6G 8G 12G
      fi
      ;;
    import)
      if (( CURRENT == 3 )); then
        _message 'new cache name'
      elif (( CURRENT == 4 )); then
        _directories
      elif (( CURRENT == 5 )); then
        _values 'size' 2G 4G 6G 8G 12G
      fi
      ;;
  esac
}

_mvm() {
  if [[ "$words[2]" == "cache" ]]; then
    shift words
    (( CURRENT-- ))
    _mvm_cache
    return
  fi

  _arguments -s -S \
    '(--go --rust --node)--go[Go profile (golang:1.27-alpine, go-mod + go-build caches)]' \
    '(--go --rust --node)--rust[Rust profile (rust:1.98-alpine, 4g RAM, cargo-reg + cargo-target)]' \
    '(--go --rust --node)--node[Node profile (node:22-alpine, npm cache)]' \
    '(-i --image)'{-i,--image}'[OCI image to run]:image:(docker.io/library/golang\:1.27-alpine docker.io/library/rust\:1.98-alpine docker.io/library/node\:22-alpine docker.io/library/alpine\:latest)' \
    '--net[Enable network (default: offline --network=none)]' \
    '--rw[Mount current dir read-write at /src (default: read-only)]' \
    '--no-src[Do not mount current directory at /src]' \
    '(-o --out)'{-o,--out}'[Mount ./DIR read-write at /out]:output dir:_directories' \
    '(-m --mem --memory)'{-m,--mem,--memory}'[MicroVM RAM limit]:size:(512m 1g 2g 4g 8g)' \
    '*'{-c,--cache}'[Attach ext4 cache image (NAME[:ro|:rw]:GUEST_PATH)]:cache spec:' \
    '*'{-t,--tmpfs}'[Mount guest tmpfs (GUEST_PATH[:SIZE])]:tmpfs spec:' \
    '*'{-e,--env}'[Pass environment variable (KEY=VAL)]:env var:' \
    '*'{-v,--volume}'[Extra podman bind mount]:volume spec:' \
    '--crun[Use crun container instead of krun microVM]' \
    '(-h --help)'{-h,--help}'[Show help]' \
    '1:subcommand or command:((cache\:"Manage ext4 cache images"))' \
    '*::command:_normal'
}

_mvm "$@"
